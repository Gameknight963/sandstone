{
  "name": "sandstone-proxy",
  "version": "0.2.0",
  "description": "An experimental web proxy utilizing sandboxed iframes and no service worker.",
  "bugs": {
    "url": "https://github.com/ading2210/sandstone/issues"
  },
  "homepage": "https://github.com/ading2210/sandstone",
  "author": "ading2210",
  "license": "AGPL-3.0-only",
  "main": "dist/sandstone.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/run-browser.mjs",
    "test:relay": "node test/run-relay.mjs",
    "test:live": "node test/run-live.mjs",
    "build": "npx webpack",
    "build:prod": "npx webpack --mode=production",
    "dev": "npx webpack --watch",
    "dev:all": "concurrently 'npm run dev' 'cd example; npm run dev'"
  },
  "dependencies": {
    "@exodus/bytes": "1.16.0",
    "@rollup/browser": "4.68.7",
    "acorn": "8.14.0",
    "astray": "^1.1.1",
    "fake-indexeddb": "^6.2.8",
    "html-encoding-sniffer": "7.0.0",
    "libcurl.js": "file:vendor/libcurl/libcurl.js-0.7.5-sandstone.4.tgz",
    "meriyah": "^6.0.3",
    "mime-db": "1.52.0",
    "parse5": "8.1.1",
    "tough-cookie": "^6.1.0",
    "whatwg-mimetype": "5.0.0"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "axios": "1.21.1",
    "concurrently": "^9.1.2",
    "dexie": "^4.4.7",
    "lz-string": "1.5.0",
    "playwright-core": "^1.65.1",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "files": [
    "src",
    "dist",
    "vendor/libcurl"
  ]
}
